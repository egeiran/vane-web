{
  "name": "vane-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vane vekkerklokke: en rolig vekkerklokke for en gammel Mac, inspirert av Vane.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "npm run build && node src/server/main.ts",
    "server": "node --watch src/server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "test": "TZ=Europe/Oslo node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
